# ==========================================
# FAMS — AssuraBackend Environment Variables
# ==========================================
# Copy this file to .env and fill in your local values.
# The .env file is gitignored and must NEVER be committed.
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ------------------------------------------
# Database (MySQL)
# ------------------------------------------
DB_SERVER=localhost
DB_PORT=3306
DB_NAME=fams_db
DB_USER=fams_user
DB_PASSWORD=changeme
DB_SSL_MODE=Required

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
JWT_SECRET_KEY=your_super_secret_key_at_least_32_characters_long
JWT_ISSUER=AssuraBackend
JWT_AUDIENCE=AssuraApp
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ------------------------------------------
# Email / SMTP (for Notifications)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=FAMS Assura

# ------------------------------------------
# CORS (comma-separated allowed origins)
# ------------------------------------------
ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

# ------------------------------------------
# Logging
# ------------------------------------------
LOG_LEVEL=Information

# ------------------------------------------
# File storage (uploads: receipts, product images, asset-request attachments)
# "Local" writes to wwwroot/uploads (default, fine for local dev / single-instance).
# "S3" writes to AWS S3 (required in Kubernetes so uploads survive pod restarts) — uses
# ASP.NET Core's double-underscore env var binding, e.g. Storage__Provider, Storage__S3__BucketName.
# No AWS access keys are read from config; the SDK's default credential chain is used
# (IRSA when running in EKS).
# ------------------------------------------
Storage__Provider=Local
Storage__S3__BucketName=
